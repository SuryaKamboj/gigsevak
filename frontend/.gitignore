# ==========================================
# Frontend Gitignore
# ==========================================

# Environment variables & Secrets (CRITICAL)
.env
.env.*
.env*.local
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!.env.example
!.env.sample
!.env.template

# API Keys, Certificates, Keystores & Private Tokens
*.pem
*.key
*.cer
*.crt
*.pfx
*.p12
*.p8
*.der
*.csr
*.keystore
*.jks
*.pub
id_rsa*
id_ecdsa*
id_ed25519*
id_dsa*

# Credentials, Cloud Secrets & Service Accounts
secrets.*
*.secret
*.secrets
.secrets*
*secret*.json
credentials.json
*credentials*.json
*serviceAccount*.json
*service-account*.json
*serviceaccount*.json
*firebase*adminsdk*.json
*firebase-adminsdk*.json
client_secret*.json
client_secrets*.json
google-services.json
GoogleService-Info.plist
token.json
tokens.json
*.token
*.tokens
.netrc

# Database dumps & local storage files
*.sqlite
*.sqlite3
*.db
*.dump

# Cloud CLI credentials
.aws/
.azure/
.gcloud/

# Dependencies
node_modules/

# Production builds
dist/
dist-ssr/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# OS and Editor directories
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
