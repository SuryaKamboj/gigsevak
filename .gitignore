# ==========================================
# Comprehensive Gitignore (Security & Secrets)
# ==========================================

# Environment variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# API Keys, Certificates, & Private Tokens
*.pem
*.key
*.cer
*.crt
*.pfx
*.p12
*.pub
id_rsa*
secrets.*
credentials.json
serviceAccountKey*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# Frontend environment variables
frontend/.env
frontend/.env.*
!frontend/.env.example

# Dependencies & Package Managers
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
dist-ssr/
build/
out/
frontend/dist/
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
