# ==========================================
# Frontend Gitignore
# ==========================================

# Environment variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# API Keys, Certificates, & Private Tokens
*.pem
*.key
*.cer
*.crt
*.pfx
*.p12
*.pub
id_rsa*
secrets.*
credentials.json
serviceAccountKey*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# Dependencies
node_modules/

# Production builds
dist/
dist-ssr/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS and Editor directories
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
